# Cadena de conexión de PostgreSQL (Supabase: Project Settings > Database > Transaction pooler, puerto 6543).
# Si se deja vacía, se usa una base de datos embebida en data/pgdata (solo desarrollo).
DATABASE_URL=
# Secreto para firmar las sesiones (cadena aleatoria larga). Obligatorio en producción.
JWT_SECRET=
# Administrador inicial (se crea solo si no hay usuarios).
ADMIN_EMAIL=
ADMIN_PASSWORD=
